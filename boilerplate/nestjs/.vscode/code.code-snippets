			"import { ApiTags } from \"@nestjs/swagger\";",
			"",
			"@Controller(\"${2:route}\")",
			"@ApiTags(\"${3:apiTag}\")",
			"export class ${1:ClassName} {",
			"  constructor($4) {}",
			"",
			"  $0",
			"}",
			""
		],
		"include": [
			"*.controller.ts",
		]
	},
	"nest:cqrs:command:new": {
		"prefix": "nest-cqrs-command-new",
		"description": "Add a template of new NestJS CQRS command class",
		"body": [
			"import { Command, ICommandHandler, CommandHandler } from \"@nestjs/cqrs\";",
			"",
			"export class ${1:CommandName} extends Command<${2:void}> {",
			"  constructor($3) {",
			"    super();",
			"  }",
			"}",
			"",
			"@CommandHandler(${1:CommandName})",
			"export class ${1:CommandName}Handler implements ICommandHandler<${1:CommandName}> {",
			"  constructor($4) {}",
			"",
			"  $0",
			"}",
			""
		],
		"exclude": [
			"*.module.ts",
			"*.controller.ts",
			"*.spec.ts"
		]
	},
