{
	// Place your potonow-backend workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	//
	// You can also restrict snippets to specific files using include/exclude patterns:
	// "Test snippet": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "test",
	// 	"body": "test('$1', () => {\n\t$0\n});",
	// 	"include": ["**/*.test.ts", "*.spec.ts"],
	// 	"exclude": ["**/temp/*.ts"],
	// 	"description": "Insert test block"
	// }
	"jest:nest:suite:new": {
		"prefix": "jest-nest-suite-new",
		"description": "Add a template of new jest test suite (with @nestjs/testing module setup)",
		"body": [
			"import { Test, TestingModule } from \"@nestjs/testing\";",
			"",
			"describe($1, () => {",
			"  let ${2:instance}: ${3:ClassName};",
			"",
			"  beforeAll(async () => {",
			"    const module = await Test.createTestingModule({",
			"      providers: [${3:ClassName}],",
			"    }).compile();",
			"",
			"    ${2:instance} = module.get(${3:ClassName});",
			"  });",
			"",
			"  $0",
			"});"
		],
		"include": [
			"*.spec.ts"
		],
	},
	"nest:module:new": {
		"prefix": "nest-module-new",
		"description": "Add a template of new NestJS module",
		"body": [
			"import { Module } from \"@nestjs/common\";",
			"",
			"@Module({",
			"  imports: [$2],",
			"  controllers: [$3],",
			"  providers: [$4],",
			"})",
			"export class ${1:ModuleName} {}",
			""
		],
		"include": [
			"*.module.ts"
		]
	},
	"nest:injectable:new": {
		"prefix": "nest-injectable-new",
		"description": "Add a template of new NestJS injectable class",
		"body": [
			"import { Injectable } from \"@nestjs/common\";",
			"",
			"@Injectable()",
			"export class ${1:ClassName} {",
			"  constructor($2) {}",
			"",
			"  $0",
			"}",
			""
		],
		"exclude": [
			"*.module.ts",
			"*.spec.ts"
		]
	},
